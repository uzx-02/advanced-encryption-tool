# ─────────────────────────────────────────────
#  Advanced Encryption Tool — .gitignore
# ─────────────────────────────────────────────

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution and packaging
dist/
build/
*.egg-info/
*.spec

# Testing and coverage artefacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# PyInstaller compiled binaries
*.exe
*.pkg

# Runtime logs
*.log
logs/

# Environment variable files — never commit these
.env
.env.*
*.env

# Editor and IDE metadata
.vscode/
.idea/
*.suo
*.user

# OS-generated metadata
.DS_Store
Thumbs.db
desktop.ini
